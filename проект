<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Конвертер единиц измерения | Длина, Масса, Объем, Температура</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            background: linear-gradient(145deg, #f0f4fa 0%, #d9e1ec 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        /* главная карточка */
        .converter-card {
            max-width: 650px;
            width: 100%;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(2px);
            border-radius: 48px;
            box-shadow: 0 25px 45px rgba(0, 0, 0, 0.2), 0 2px 6px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            transition: all 0.2s ease;
        }

        /* шапка */
        .header {
            background: #1e2a3e;
            color: white;
            padding: 24px 28px;
            text-align: center;
        }

        .header h1 {
            font-size: 1.9rem;
            font-weight: 600;
            letter-spacing: -0.3px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .header h1 span {
            background: #ffb347;
            font-size: 1.2rem;
            padding: 4px 12px;
            border-radius: 60px;
            color: #1e2a3e;
            font-weight: 500;
        }

        .sub {
            font-size: 0.85rem;
            opacity: 0.8;
            margin-top: 8px;
        }

        /* табы категорий */
        .tabs {
            display: flex;
            background: #ffffff;
            border-bottom: 2px solid #e2e8f0;
            padding: 0 16px;
            gap: 6px;
            flex-wrap: wrap;
        }

        .tab-btn {
            background: transparent;
            border: none;
            padding: 16px 20px;
            font-size: 1rem;
            font-weight: 600;
            color: #4a5568;
            cursor: pointer;
            transition: all 0.2s;
            border-radius: 40px 40px 0 0;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .tab-btn i {
            font-style: normal;
            font-weight: 500;
            font-size: 1.2rem;
        }

        .tab-btn.active {
            color: #1e2a3e;
            background: #f8fafc;
            border-bottom: 3px solid #ffb347;
        }

        .tab-btn:hover:not(.active) {
            background: #f1f5f9;
            color: #2c3e50;
        }

        /* контент */
        .content-panel {
            padding: 28px 24px 32px;
            background: #ffffff;
        }

        .category {
            display: none;
            animation: fadeIn 0.25s ease;
        }

        .category.active-cat {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px);}
            to { opacity: 1; transform: translateY(0);}
        }

        /* блоки ввода */
        .conversion-row {
            margin-bottom: 28px;
        }

        .label {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 8px;
            font-size: 0.85rem;
            letter-spacing: 0.3px;
            display: flex;
            justify-content: space-between;
        }

        .input-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: center;
            background: #f1f5f9;
            border-radius: 32px;
            padding: 8px 16px;
            border: 1px solid #e2e8f0;
            transition: 0.2s;
        }

        .input-group:focus-within {
            border-color: #ffb347;
            box-shadow: 0 0 0 3px rgba(255, 180, 71, 0.3);
            background: white;
        }

        .input-group input {
            flex: 2;
            min-width: 140px;
            background: transparent;
            border: none;
            font-size: 1.3rem;
            padding: 12px 0;
            outline: none;
            font-weight: 500;
            color: #0f172a;
        }

        .input-group select {
            flex: 1;
            background: white;
            border: 1px solid #cbd5e1;
            border-radius: 48px;
            padding: 10px 12px;
            font-weight: 500;
            font-size: 0.9rem;
            cursor: pointer;
            outline: none;
            transition: 0.2s;
        }

        .input-group select:focus {
            border-color: #ffb347;
        }

        /* кнопка свап */
        .swap-btn {
            background: #f1f5f9;
            border: none;
            font-size: 1.7rem;
            width: 48px;
            height: 48px;
            border-radius: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 12px auto;
            cursor: pointer;
            transition: 0.2s;
            color: #1e2a3e;
            font-weight: bold;
        }

        .swap-btn:hover {
            background: #ffb347;
            color: white;
            transform: rotate(180deg);
        }

        /* температура особый стиль */
        .temp-note {
            font-size: 0.75rem;
            text-align: center;
            margin-top: 20px;
            color: #5b6e8c;
            background: #f8fafc;
            padding: 8px;
            border-radius: 60px;
        }

        hr {
            margin: 20px 0;
            border-color: #eef2f6;
        }

        footer {
            background: #f8fafc;
            text-align: center;
            font-size: 0.7rem;
            padding: 14px;
            color: #4b5563;
            border-top: 1px solid #e2e8f0;
        }

        @media (max-width: 540px) {
            .converter-card {
                border-radius: 32px;
            }
            .input-group {
                flex-direction: column;
                align-items: stretch;
            }
            .input-group input {
                text-align: center;
            }
            .tab-btn {
                padding: 12px 12px;
                font-size: 0.85rem;
            }
        }
    </style>
</head>
<body>

<div class="converter-card">
    <div class="header">
        <h1>
            📐 Конвертер величин
            <span>единицы</span>
        </h1>
        <div class="sub">Длина · Масса · Объем · Температура</div>
    </div>

    <div class="tabs">
        <button class="tab-btn active" data-cat="length">📏 Длина</button>
        <button class="tab-btn" data-cat="mass">⚖️ Масса</button>
        <button class="tab-btn" data-cat="volume">🧴 Объем</button>
        <button class="tab-btn" data-cat="temp">🌡️ Температура</button>
    </div>

    <div class="content-panel">
        <!-- Категория: Длина -->
        <div id="length" class="category active-cat">
            <div class="conversion-row">
                <div class="label">🔽 Из</div>
                <div class="input-group">
                    <input type="number" id="length-from-val" placeholder="0" value="1" step="any">
                    <select id="length-from-unit"></select>
                </div>
            </div>
            <div class="swap-btn" id="swap-length">⇅</div>
            <div class="conversion-row">
                <div class="label">🔼 В</div>
                <div class="input-group">
                    <input type="number" id="length-to-val" placeholder="результат" step="any" readonly>
                    <select id="length-to-unit"></select>
                </div>
            </div>
        </div>

        <!-- Категория: Масса -->
        <div id="mass" class="category">
            <div class="conversion-row">
                <div class="label">🔽 Из</div>
                <div class="input-group">
                    <input type="number" id="mass-from-val" placeholder="0" value="1" step="any">
                    <select id="mass-from-unit"></select>
                </div>
            </div>
            <div class="swap-btn" id="swap-mass">⇅</div>
            <div class="conversion-row">
                <div class="label">🔼 В</div>
                <div class="input-group">
                    <input type="number" id="mass-to-val" placeholder="результат" step="any" readonly>
                    <select id="mass-to-unit"></select>
                </div>
            </div>
        </div>

        <!-- Категория: Объем -->
        <div id="volume" class="category">
            <div class="conversion-row">
                <div class="label">🔽 Из</div>
                <div class="input-group">
                    <input type="number" id="volume-from-val" placeholder="0" value="1" step="any">
                    <select id="volume-from-unit"></select>
                </div>
            </div>
            <div class="swap-btn" id="swap-volume">⇅</div>
            <div class="conversion-row">
                <div class="label">🔼 В</div>
                <div class="input-group">
                    <input type="number" id="volume-to-val" placeholder="результат" step="any" readonly>
                    <select id="volume-to-unit"></select>
                </div>
            </div>
        </div>

        <!-- Категория: Температура -->
        <div id="temp" class="category">
            <div class="conversion-row">
                <div class="label">🌡️ Из градусов</div>
                <div class="input-group">
                    <input type="number" id="temp-from-val" placeholder="0" value="0" step="any">
                    <select id="temp-from-unit"></select>
                </div>
            </div>
            <div class="swap-btn" id="swap-temp">⇅</div>
            <div class="conversion-row">
                <div class="label">🌡️ В градусы</div>
                <div class="input-group">
                    <input type="number" id="temp-to-val" placeholder="результат" step="any" readonly>
                    <select id="temp-to-unit"></select>
                </div>
            </div>
            <div class="temp-note">⚡ Поддерживается: Цельсий, Фаренгейт, Кельвин</div>
        </div>
    </div>
    <footer>⚡ Мгновенная конвертация • Точные коэффициенты • Интуитивный интерфейс</footer>
</div>

<script>
    // --------------------------------------------------------------
    // 1. БАЗОВЫЕ ДАННЫЕ ДЛЯ КАЖДОЙ КАТЕГОРИИ (метры, килограммы, литры как основа)
    // --------------------------------------------------------------

    // ДЛИНА: базовая единица = метр
    const lengthUnits = {
        "метр (м)": 1,
        "километр (км)": 1000,
        "сантиметр (см)": 0.01,
        "миллиметр (мм)": 0.001,
        "миля (mi)": 1609.344,
        "фут (ft)": 0.3048,
        "дюйм (in)": 0.0254,
        "ярд (yd)": 0.9144
    };

    // МАССА: базовая единица = килограмм
    const massUnits = {
        "килограмм (кг)": 1,
        "грамм (г)": 0.001,
        "миллиграмм (мг)": 0.000001,
        "тонна (т)": 1000,
        "фунт (lb)": 0.45359237,
        "унция (oz)": 0.028349523125
    };

    // ОБЪЕМ: базовая единица = литр
    const volumeUnits = {
        "литр (л)": 1,
        "миллилитр (мл)": 0.001,
        "кубический метр (м³)": 1000,
        "галлон (US)": 3.785411784,
        "кварта (US)": 0.946352946,
        "чашка (cup)": 0.2365882365
    };

    // ТЕМПЕРАТУРА: не линейна, используем отдельную функцию
    const tempUnitsList = ["Цельсий (°C)", "Фаренгейт (°F)", "Кельвин (K)"];

    // --------------------------------------------------------------
    // 2. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ КОНВЕРТАЦИИ
    // --------------------------------------------------------------

    // Конвертер линейных величин: значение из единицы A в единицу B, зная словарь (baseFactor)
    function convertLinear(value, fromUnitKey, toUnitKey, unitDict) {
        if (isNaN(value) || value === "" || value === null) return 0;
        const fromFactor = unitDict[fromUnitKey];
        const toFactor = unitDict[toUnitKey];
        if (!fromFactor || !toFactor) return 0;
        const valueInBase = value * fromFactor;
        return valueInBase / toFactor;
    }

    // Температурные преобразования
    function convertTemperature(value, fromScale, toScale) {
        if (isNaN(value)) return 0;
        let celsius = 0;
        // Приводим к Цельсию
        if (fromScale === "Цельсий (°C)") celsius = value;
        else if (fromScale === "Фаренгейт (°F)") celsius = (value - 32) * 5 / 9;
        else if (fromScale === "Кельвин (K)") celsius = value - 273.15;
        else return 0;
        
        // Из Цельсия в нужную шкалу
        if (toScale === "Цельсий (°C)") return celsius;
        else if (toScale === "Фаренгейт (°F)") return (celsius * 9 / 5) + 32;
        else if (toScale === "Кельвин (K)") return celsius + 273.15;
        return 0;
    }

    // --------------------------------------------------------------
    // 3. ЗАПОЛНЕНИЕ ВЫПАДАЮЩИХ СПИСКОВ
    // --------------------------------------------------------------
    function populateSelect(selectEl, unitsObj) {
        selectEl.innerHTML = "";
        for (let unitKey in unitsObj) {
            const option = document.createElement("option");
            option.value = unitKey;
            option.textContent = unitKey;
            selectEl.appendChild(option);
        }
    }

    function populateTempSelect(selectEl) {
        selectEl.innerHTML = "";
        tempUnitsList.forEach(unit => {
            const option = document.createElement("option");
            option.value = unit;
            option.textContent = unit;
            selectEl.appendChild(option);
        });
    }

    // --------------------------------------------------------------
    // 4. НАСТРОЙКА DOM ЭЛЕМЕНТОВ И ОБНОВЛЕНИЕ ЗНАЧЕНИЙ
    // --------------------------------------------------------------

    // Длина
    const lengthFromVal = document.getElementById("length-from-val");
    const lengthToVal = document.getElementById("length-to-val");
    const lengthFromUnit = document.getElementById("length-from-unit");
    const lengthToUnit = document.getElementById("length-to-unit");

    // Масса
    const massFromVal = document.getElementById("mass-from-val");
    const massToVal = document.getElementById("mass-to-val");
    const massFromUnit = document.getElementById("mass-from-unit");
    const massToUnit = document.getElementById("mass-to-unit");

    // Объем
    const volumeFromVal = document.getElementById("volume-from-val");
    const volumeToVal = document.getElementById("volume-to-val");
    const volumeFromUnit = document.getElementById("volume-from-unit");
    const volumeToUnit = document.getElementById("volume-to-unit");

    // Температура
    const tempFromVal = document.getElementById("temp-from-val");
    const tempToVal = document.getElementById("temp-to-val");
    const tempFromUnit = document.getElementById("temp-from-unit");
    const tempToUnit = document.getElementById("temp-to-unit");

    // Заполнение дропдаунов
    populateSelect(lengthFromUnit, lengthUnits);
    populateSelect(lengthToUnit, lengthUnits);
    // установим красивые дефолты: из метра в футы
    lengthFromUnit.value = "метр (м)";
    lengthToUnit.value = "фут (ft)";

    populateSelect(massFromUnit, massUnits);
    populateSelect(massToUnit, massUnits);
    massFromUnit.value = "килограмм (кг)";
    massToUnit.value = "фунт (lb)";

    populateSelect(volumeFromUnit, volumeUnits);
    populateSelect(volumeToUnit, volumeUnits);
    volumeFromUnit.value = "литр (л)";
    volumeToUnit.value = "галлон (US)";

    populateTempSelect(tempFromUnit);
    populateTempSelect(tempToUnit);
    tempFromUnit.value = "Цельсий (°C)";
    tempToUnit.value = "Фаренгейт (°F)";

    // --------------------------------------------------------------
    // 5. ФУНКЦИИ ОБНОВЛЕНИЯ РЕЗУЛЬТАТОВ (реактивность)
    // --------------------------------------------------------------
    function updateLength() {
        const val = parseFloat(lengthFromVal.value);
        if (isNaN(val)) {
            lengthToVal.value = "";
            return;
        }
        const fromU = lengthFromUnit.value;
        const toU = lengthToUnit.value;
        const result = convertLinear(val, fromU, toU, lengthUnits);
        lengthToVal.value = result.toFixed(6).replace(/\.?0+$/, '');
        if (Math.abs(result) < 0.000001 && result !== 0) lengthToVal.value = result.toExponential(6);
        else if (result.toString().length > 12) lengthToVal.value = result.toFixed(8);
    }

    function updateMass() {
        const val = parseFloat(massFromVal.value);
        if (isNaN(val)) {
            massToVal.value = "";
            return;
        }
        const fromU = massFromUnit.value;
        const toU = massToUnit.value;
        const result = convertLinear(val, fromU, toU, massUnits);
        massToVal.value = result.toFixed(6).replace(/\.?0+$/, '');
        if (Math.abs(result) < 0.000001 && result !== 0) massToVal.value = result.toExponential(6);
    }

    function updateVolume() {
        const val = parseFloat(volumeFromVal.value);
        if (isNaN(val)) {
            volumeToVal.value = "";
            return;
        }
        const fromU = volumeFromUnit.value;
        const toU = volumeToUnit.value;
        const result = convertLinear(val, fromU, toU, volumeUnits);
        volumeToVal.value = result.toFixed(6).replace(/\.?0+$/, '');
        if (Math.abs(result) < 0.000001 && result !== 0) volumeToVal.value = result.toExponential(6);
    }

    function updateTemp() {
        const val = parseFloat(tempFromVal.value);
        if (isNaN(val)) {
            tempToVal.value = "";
            return;
        }
        const fromU = tempFromUnit.value;
        const toU = tempToUnit.value;
        const result = convertTemperature(val, fromU, toU);
        tempToVal.value = result.toFixed(4).replace(/\.?0+$/, '');
        if (Math.abs(result) < 0.0001 && result !== 0) tempToVal.value = result.toExponential(5);
    }

    // --------------------------------------------------------------
    // 6. ОБРАБОТЧИКИ СОБЫТИЙ (input, change)
    // --------------------------------------------------------------
    function bindEvents() {
        // Длина
        lengthFromVal.addEventListener("input", updateLength);
        lengthFromUnit.addEventListener("change", updateLength);
        lengthToUnit.addEventListener("change", updateLength);
        // Масса
        massFromVal.addEventListener("input", updateMass);
        massFromUnit.addEventListener("change", updateMass);
        massToUnit.addEventListener("change", updateMass);
        // Объем
        volumeFromVal.addEventListener("input", updateVolume);
        volumeFromUnit.addEventListener("change", updateVolume);
        volumeToUnit.addEventListener("change", updateVolume);
        // Температура
        tempFromVal.addEventListener("input", updateTemp);
        tempFromUnit.addEventListener("change", updateTemp);
        tempToUnit.addEventListener("change", updateTemp);
    }

    // --------------------------------------------------------------
    // 7. КНОПКИ ОБМЕНА (SWAP)
    // --------------------------------------------------------------
    function setupSwaps() {
        const swapLength = document.getElementById("swap-length");
        swapLength.addEventListener("click", () => {
            // меняем местами значения select и значение из поля
            const fromUnitOld = lengthFromUnit.value;
            const toUnitOld = lengthToUnit.value;
            lengthFromUnit.value = toUnitOld;
            lengthToUnit.value = fromUnitOld;
            // также обмениваем числа в полях ввода (чтобы результат стал исходным)
            const fromVal = lengthFromVal.value;
            const toVal = lengthToVal.value;
            if (!isNaN(parseFloat(toVal)) && toVal !== "") {
                lengthFromVal.value = toVal;
            }
            updateLength();
        });

        const swapMass = document.getElementById("swap-mass");
        swapMass.addEventListener("click", () => {
            const fromUnitOld = massFromUnit.value;
            const toUnitOld = massToUnit.value;
            massFromUnit.value = toUnitOld;
            massToUnit.value = fromUnitOld;
            const toVal = massToVal.value;
            if (!isNaN(parseFloat(toVal)) && toVal !== "") {
                massFromVal.value = toVal;
            }
            updateMass();
        });

        const swapVolume = document.getElementById("swap-volume");
        swapVolume.addEventListener("click", () => {
            const fromUnitOld = volumeFromUnit.value;
            const toUnitOld = volumeToUnit.value;
            volumeFromUnit.value = toUnitOld;
            volumeToUnit.value = fromUnitOld;
            const toVal = volumeToVal.value;
            if (!isNaN(parseFloat(toVal)) && toVal !== "") {
                volumeFromVal.value = toVal;
            }
            updateVolume();
        });

        const swapTemp = document.getElementById("swap-temp");
        swapTemp.addEventListener("click", () => {
            const fromUnitOld = tempFromUnit.value;
            const toUnitOld = tempToUnit.value;
            tempFromUnit.value = toUnitOld;
            tempToUnit.value = fromUnitOld;
            const toVal = tempToVal.value;
            if (!isNaN(parseFloat(toVal)) && toVal !== "") {
                tempFromVal.value = toVal;
            }
            updateTemp();
        });
    }

    // --------------------------------------------------------------
    // 8. ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК + ПЕРВОНАЧАЛЬНЫЙ РАСЧЕТ
    // --------------------------------------------------------------
    function initTabs() {
        const tabs = document.querySelectorAll(".tab-btn");
        const categories = document.querySelectorAll(".category");
        
        tabs.forEach(btn => {
            btn.addEventListener("click", () => {
                const catId = btn.getAttribute("data-cat");
                // Убираем активные классы у кнопок
                tabs.forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                // Скрыть все категории
                categories.forEach(cat => cat.classList.remove("active-cat"));
                const activeCategory = document.getElementById(catId);
                if (activeCategory) activeCategory.classList.add("active-cat");
                
                // При переключении обновляем текущий видимый конвертер (для подстраховки)
                if (catId === "length") updateLength();
                if (catId === "mass") updateMass();
                if (catId === "volume") updateVolume();
                if (catId === "temp") updateTemp();
            });
        });
    }

    // --------------------------------------------------------------
    // 9. ДОПОЛНИТЕЛЬНО: ЗАЩИТА ОТ ГЛЮКОВ, КОРРЕКЦИЯ ПРИ СТАРТЕ
    // --------------------------------------------------------------
    function initialConvertAll() {
        updateLength();
        updateMass();
        updateVolume();
        updateTemp();
    }

    // подписываемся на все + чистим нечитаемые значения, если поле ввода пустое, ставим 0? но лучше не принудительно
    function setValidNumbers() {
        // если пользователь удалит содержимое, конвертер не ломается (NaN не обновляет вывод)
        // дополнительная эргономика: если поле пустое, то при переключении свапа ставим аккуратно
        const allNumberInputs = [lengthFromVal, massFromVal, volumeFromVal, tempFromVal];
        allNumberInputs.forEach(inp => {
            inp.addEventListener("blur", function() {
                if (this.value === "" || this.value === "-") {
                    this.value = 0;
                    // триггер обновления вручную
                    if (this.id === "length-from-val") updateLength();
                    if (this.id === "mass-from-val") updateMass();
                    if (this.id === "volume-from-val") updateVolume();
                    if (this.id === "temp-from-val") updateTemp();
                }
            });
        });
    }

    // --------------------------------------------------------------
    // СТАРТ
    // --------------------------------------------------------------
    function init() {
        bindEvents();
        setupSwaps();
        initTabs();
        initialConvertAll();
        setValidNumbers();
    }
    
    init();
